{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodePackage",
  "type": "object",
  "required": ["files", "entryProject", "targetFramework", "expectedOutputContains"],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\.\\./)(?!.*(/|\\\\)\\.\\.([/\\\\]|$))(?!/)(?![A-Za-z]:)(?!\\\\\\\\)[A-Za-z0-9_.\\-/\\\\]+$"
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "entryProject": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\./)(?!.*(/|\\\\)\\.\\.([/\\\\]|$))(?!/)(?![A-Za-z]:)(?!\\\\\\\\)[A-Za-z0-9_.\\-/\\\\]+\\.csproj$"
    },
    "targetFramework": {
      "type": "string",
      "const": "net9.0"
    },
    "expectedOutputContains": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
