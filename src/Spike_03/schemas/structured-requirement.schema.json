{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StructuredRequirement",
  "type": "object",
  "required": [
    "title",
    "actors",
    "goal",
    "acceptanceCriteriaDraft",
    "constraints",
    "priority"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteriaDraft": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
