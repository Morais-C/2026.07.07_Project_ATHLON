{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeRequest",
  "type": "object",
  "required": [
    "kind",
    "title",
    "description"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["feature", "bugfix"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "stepsToReproduce": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "expectedBehavior": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "actualBehavior": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "suspectedPaths": {
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
