{
  "$schema": "./archetype.schema.json",
  "archetypeId": "console-v1",
  "version": "1.0.0-draft",
  "status": "training",
  "displayName": "Console Application v1",
  "description": "Bounded .NET console change archetype (read → process → print). Spike_05 formal pack — Phase 0 skeleton.",
  "paths": {
    "bounds": "bounds.md",
    "codeContext": "code-context.md",
    "changeRequest": "change-request.md",
    "schemas": "schemas/",
    "prompts": "prompts/",
    "patchApply": "patch-apply.md",
    "proof": "proof/pipeline.json",
    "demos": "demos/change-requests.json"
  },
  "baseline": {
    "fixtureId": "echo-v1",
    "fixturePath": "../../fixtures/echo-v1"
  },
  "codeContext": {
    "maxFilesAllowed": 4,
    "maxCharsAllowed": 32000,
    "includeExtensions": [".cs", ".csproj"]
  },
  "changeRequest": {
    "kinds": ["feature", "bugfix"]
  },
  "artifactChain": [
    { "type": "ChangeRequest", "producer": "host", "schema": "schemas/change-request.schema.json" },
    { "type": "StructuredChange", "producer": "Analyst", "schema": "schemas/structured-change.schema.json" },
    { "type": "CodeContext", "producer": "CodeContextBuilder", "schema": "schemas/code-context.schema.json" },
    { "type": "ImplementationPlan", "producer": "Planner", "schema": "schemas/implementation-plan.schema.json" },
    { "type": "PatchPackage", "producer": "Coder", "schema": "schemas/patch-package.schema.json" },
    { "type": "ApplyResult", "producer": "Applier", "schema": null }
  ],
  "agents": {
    "Analyst": { "prompt": "prompts/analyst-v1.txt", "outputSchema": "schemas/structured-change.schema.json" },
    "Planner": { "prompt": "prompts/planner-v1.txt", "outputSchema": "schemas/implementation-plan.schema.json" },
    "Coder": { "prompt": "prompts/coder-v1.txt", "outputSchema": "schemas/patch-package.schema.json" }
  },
  "proofPipeline": "proof/pipeline.json"
}
