{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeContext",
  "type": "object",
  "required": [
    "fixtureId",
    "entryProject",
    "targetFramework",
    "files",
    "totalChars",
    "maxFilesAllowed",
    "maxCharsAllowed"
  ],
  "properties": {
    "fixtureId": {
      "type": "string",
      "minLength": 1
    },
    "entryProject": {
      "type": "string",
      "minLength": 1
    },
    "targetFramework": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "content", "contentSha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          },
          "contentSha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "totalChars": {
      "type": "integer",
      "minimum": 0
    },
    "maxFilesAllowed": {
      "type": "integer",
      "minimum": 1
    },
    "maxCharsAllowed": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
