{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementationArtifact",
  "type": "object",
  "required": ["title", "summary", "tasks", "acceptanceCriteria", "technicalNotes"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "estimate"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "estimate": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "technicalNotes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
